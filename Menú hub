RS.RenderStepped:Connect(function()
    circle.Position = Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
    circle.Radius = FOV

    local topCenter = Vector2.new(camera.ViewportSize.X/2, 6)

    -- Boxes (limpia si no está vivo)
    for plr, lines in pairs(boxDrawings) do
        if not isAlive(plr) then
            removeESP(plr)
        else
            local root = plr.Character.HumanoidRootPart
            local size = Vector3.new(2.5, 5.5, 2.5)
            local cf = root.CFrame
            local corners = {
                cf * CFrame.new( size.X/2,  size.Y/2,  size.Z/2),
                cf * CFrame.new(-size.X/2,  size.Y/2,  size.Z/2),
                cf * CFrame.new(-size.X/2, -size.Y/2,  size.Z/2),
                cf * CFrame.new( size.X/2, -size.Y/2,  size.Z/2),
                cf * CFrame.new( size.X/2,  size.Y/2, -size.Z/2),
                cf * CFrame.new(-size.X/2,  size.Y/2, -size.Z/2),
                cf * CFrame.new(-size.X/2, -size.Y/2, -size.Z/2),
                cf * CFrame.new( size.X/2, -size.Y/2, -size.Z/2),
            }
            local points = {}
            for i, corner in pairs(corners) do
                local pos, onScreen = camera:WorldToViewportPoint(corner.Position)
                points[i] = onScreen and Vector2.new(pos.X, pos.Y) or nil
            end
            local connections = {{1,2},{2,3},{3,4},{4,1},{5,6},{6,7},{7,8},{8,5},{1,5},{2,6},{3,7},{4,8}}
            for i, conn in pairs(connections) do
                if lines[i] and points[conn[1]] and points[conn[2]] then
                    lines[i].From = points[conn[1]]
                    lines[i].To = points[conn[2]]
                    lines[i].Visible = true
                elseif lines[i] then
                    lines[i].Visible = false
                end
            end
        end
    end

    -- Tracers
    for plr, line in pairs(tracerDrawings) do
        if not isAlive(plr) then
            removeESP(plr)
        else
            local to = camera:WorldToViewportPoint(plr.Character.HumanoidRootPart.Position)
            if to.Z > 0 then
                line.From = topCenter
                line.To = Vector2.new(to.X, to.Y)
                line.Visible = true
            else
                line.Visible = false
            end
        end
    end

    -- Skeleton
    for plr, lines in pairs(skeletonDrawings) do
        if not isAlive(plr) then
            removeESP(plr)
        else
            local char = plr.Character
            local function getPos(name)
                local part = char:FindFirstChild(name)
                if part then
                    local pos, onScreen = camera:WorldToViewportPoint(part.Position)
                    if onScreen then return Vector2.new(pos.X, pos.Y) end
                end
                return nil
            end

            local head = getPos("Head")
            local upperTorso = getPos("UpperTorso") or getPos("Torso")
            local lowerTorso = getPos("LowerTorso") or getPos("Torso")
            local leftUpperArm = getPos("LeftUpperArm") or getPos("Left Arm")
            local rightUpperArm = getPos("RightUpperArm") or getPos("Right Arm")
            local leftLowerArm = getPos("LeftLowerArm") or getPos("Left Arm")
            local rightLowerArm = getPos("RightLowerArm") or getPos("Right Arm")
            local leftHand = getPos("LeftHand") or getPos("Left Arm")
            local rightHand = getPos("RightHand") or getPos("Right Arm")
            local leftUpperLeg = getPos("LeftUpperLeg") or getPos("Left Leg")
            local rightUpperLeg = getPos("RightUpperLeg") or getPos("Right Leg")
            local leftLowerLeg = getPos("LeftLowerLeg") or getPos("Left Leg")
            local rightLowerLeg = getPos("RightLowerLeg") or getPos("Right Leg")
            local leftFoot = getPos("LeftFoot") or getPos("Left Leg")
            local rightFoot = getPos("RightFoot") or getPos("Right Leg")

            local connections = {
                {head, upperTorso},
                {upperTorso, lowerTorso},
                {upperTorso, leftUpperArm},
                {upperTorso, rightUpperArm},
                {leftUpperArm, leftLowerArm},
                {rightUpperArm, rightLowerArm},
                {leftLowerArm, leftHand},
                {rightLowerArm, rightHand},
                {lowerTorso, leftUpperLeg},
                {lowerTorso, rightUpperLeg},
                {leftUpperLeg, leftLowerLeg},
                {rightUpperLeg, rightLowerLeg},
                {leftLowerLeg, leftFoot},
                {rightLowerLeg, rightFoot},
            }

            for i, conn in pairs(connections) do
                if lines[i] and conn[1] and conn[2] then
                    lines[i].From = conn[1]
                    lines[i].To = conn[2]
                    lines[i].Visible = true
                elseif lines[i] then
                    lines[i].Visible = false
                end
            end
        end
    end
end)

