local function crearTabBtn(icon, nombre, orden)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 50)
    btn.BackgroundColor3 = CONTENT_BG
    btn.BackgroundTransparency = 0.5
    btn.BorderSizePixel = 0
    btn.LayoutOrder = orden
    btn.Parent = leftPanel
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)

    local ico = Instance.new("TextLabel")
    ico.Size = UDim2.new(1, 0, 0, 25)
    ico.Position = UDim2.new(0, 0, 0, 5)
    ico.BackgroundTransparency = 1
    ico.Text = icon
    ico.TextSize = 18
    ico.Font = Enum.Font.GothamBold
    ico.TextColor3 = Color3.fromRGB(200, 200, 200)
    ico.Parent = btn

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, 0, 0, 18)
    lbl.Position = UDim2.new(0, 0, 0, 28)
    lbl.BackgroundTransparency = 1
    lbl.Text = nombre
    lbl.TextSize = 10
    lbl.Font = Enum.Font.Gotham
    lbl.TextColor3 = Color3.fromRGB(180, 180, 180)
    lbl.Parent = btn

    -- Page
    local page = Instance.new("Frame")
    page.Size = UDim2.new(1, 0, 0, 0)
    page.AutomaticSize = Enum.AutomaticSize.Y
    page.BackgroundTransparency = 1
    page.LayoutOrder = orden
    page.Visible = false
    page.Parent = rightPanel

    local pageLayout = Instance.new("UIListLayout")
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Padding = UDim.new(0, 6)
    pageLayout.Parent = page

    pages[nombre] = {btn = btn, page = page, ico = ico, lbl = lbl}

    btn.MouseButton1Click:Connect(function()
        for _, p in pairs(pages) do
            p.page.Visible = false
            p.btn.BackgroundTransparency = 0.5
            p.ico.TextColor3 = Color3.fromRGB(200, 200, 200)
            p.lbl.TextColor3 = Color3.fromRGB(180, 180, 180)
        end
        page.Visible = true
        btn.BackgroundTransparency = 0
        ico.TextColor3 = AZUL
        lbl.TextColor3 = AZUL
        currentTab = nombre
    end)

    return page
end

