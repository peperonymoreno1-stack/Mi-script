local function crearSlider(parent, texto, posY, min, max, default, callback)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -8, 0, 50)
    row.Position = UDim2.new(0, 4, 0, posY)
    row.BackgroundColor3 = Color3.fromRGB(0, 20, 60)
    row.BorderSizePixel = 0
    row.Parent = parent
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, -10, 0, 20)
    label.Position = UDim2.new(0, 8, 0, 4)
    label.BackgroundTransparency = 1
    label.Text = texto .. ": " .. default
    label.TextColor3 = Color3.fromRGB(200, 220, 255)
    label.TextSize = 12
    label.Font = Enum.Font.Gotham
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = row

    local sliderBg = Instance.new("Frame")
    sliderBg.Size = UDim2.new(1, -16, 0, 8)
    sliderBg.Position = UDim2.new(0, 8, 0, 32)
    sliderBg.BackgroundColor3 = Color3.fromRGB(30, 30, 60)
    sliderBg.BorderSizePixel = 0
    sliderBg.Parent = row
    Instance.new("UICorner", sliderBg).CornerRadius = UDim.new(1, 0)

    local sliderFill = Instance.new("Frame")
    sliderFill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
    sliderFill.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
    sliderFill.BorderSizePixel = 0
    sliderFill.Parent = sliderBg
    Instance.new("UICorner", sliderFill).CornerRadius = UDim.new(1, 0)

    local draggingSlider = false
    sliderBg.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingSlider = true
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if draggingSlider and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMove) then
            local relX = math.clamp((input.Position.X - sliderBg.AbsolutePosition.X) / sliderBg.AbsoluteSize.X, 0, 1)
            sliderFill.Size = UDim2.new(relX, 0, 1, 0)
            local value = math.floor(min + (max - min) * relX)
            label.Text = texto .. ": " .. value
            callback(value)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
            draggingSlider = false
        end
    end)
end

local tabActiva = nil
local function crearTab(nombre, icono, posY, page)
    local tab = Instance.new("TextButton")
    tab.Size = UDim2.new(1, -8, 0, 48)
    tab.Position = UDim2.new(0, 4, 0, posY)
    tab.BackgroundColor3 = Color3.fromRGB(0, 20, 60)
    tab.BorderSizePixel = 0
    tab.Text = icono .. "\n" .. nombre
    tab.TextColor3 = Color3.fromRGB(150, 200, 255)
    tab.TextSize = 11
    tab.Font = Enum.Font.Gotham
    tab.Parent = leftPanel
    Instance.new("UICorner", tab).CornerRadius = UDim.new(0, 6)

    tab.MouseButton1Click:Connect(function()
        for _, p in pairs(pages) do p.Visible = false end
        page.Visible = true
        if tabActiva then
            tabActiva.BackgroundColor3 = Color3.fromRGB(0, 20, 60)
            tabActiva.TextColor3 = Color3.fromRGB(150, 200, 255)
        end
        tab.BackgroundColor3 = Color3.fromRGB(0, 80, 200)
        tab.TextColor3 = Color3.fromRGB(255, 255, 255)
        tabActiva = tab
    end)

    return tab
end

