local sliding = false
local function updateSlider(inputX)
    local absPos = sliderBG.AbsolutePosition.X
    local absSize = sliderBG.AbsoluteSize.X
    local t = math.clamp((inputX - absPos) / absSize, 0, 1)
    FOV = math.floor(50 + t * 350)
    sliderFill.Size = UDim2.new(t, 0, 1, 0)
    sliderBtn.Position = UDim2.new(t, -11, 0.5, -11)
    fovLabel.Text = "FOV: " .. FOV
    circle.Radius = FOV
end

sliderBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliding = true
        frame.Draggable = false
    end
end)
sliderBG.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliding = true
        frame.Draggable = false
        updateSlider(input.Position.X)
    end
end)
UIS.InputChanged:Connect(function(input)
    if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateSlider(input.Position.X)
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliding = false
        frame.Draggable = true
    end
end)

local espBoxes = false
local tracersOn = false
local chamsOn = false
local skeletonOn = false

local boxDrawings = {}
local tracerDrawings = {}
local skeletonDrawings = {}
local highlights = {}

local function removeESP(plr)
    if boxDrawings[plr] then
        for _, line in pairs(boxDrawings[plr]) do
            pcall(function() line:Remove() end)
        end
        boxDrawings[plr] = nil
    end
    if tracerDrawings[plr] then
        pcall(function() tracerDrawings[plr]:Remove() end)
        tracerDrawings[plr] = nil
    end
    if skeletonDrawings[plr] then
        for _, line in pairs(skeletonDrawings[plr]) do
            pcall(function() line:Remove() end)
        end
        skeletonDrawings[plr] = nil
    end
    if highlights[plr] then
        pcall(function() highlights[plr]:Destroy() end)
        highlights[plr] = nil
    end
end

local function clearAll()
    for plr, _ in pairs(boxDrawings) do removeESP(plr) end
    for plr, _ in pairs(tracerDrawings) do removeESP(plr) end
    for plr, _ in pairs(skeletonDrawings) do removeESP(plr) end
    for plr, _ in pairs(highlights) do removeESP(plr) end
end

local function isAlive(plr)
    if not plr or not plr.Character then return false end
    local hum = plr.Character:FindFirstChild("Humanoid")
    local root = plr.Character:FindFirstChild("HumanoidRootPart")
    return hum and root and hum.Health > 0
end

local function createBox(plr)
    if not espBoxes or plr == player or not isAlive(plr) then return end
    if boxDrawings[plr] then return end
    local lines = {}
    for i = 1, 12 do
        local ok, line = pcall(function() return Drawing.new("Line") end)
        if ok and line then
            line.Color = Color3.fromRGB(255, 50, 50)
            line.Thickness = 1.5
            line.Visible = true
            table.insert(lines, line)
        end
    end
    if #lines > 0 then boxDrawings[plr] = lines end
end

local function createTracer(plr)
    if not tracersOn or plr == player or not isAlive(plr) then return end
    if tracerDrawings[plr] then return end
    local ok, line = pcall(function() return Drawing.new("Line") end)
    if ok and line then
        line.Color = Color3.fromRGB(255, 50, 50)
        line.Thickness = 1.5
        line.Visible = true
        tracerDrawings[plr] = line
    end
end

local function createChams(plr)
    if not chamsOn or plr == player or not isAlive(plr) then return end
    if highlights[plr] then return end
    local hl = Instance.new("Highlight")
    hl.Adornee = plr.Character
    hl.FillColor = Color3.fromRGB(255, 40, 40)
    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
    hl.FillTransparency = 0.55
    hl.Parent = plr.Character
    highlights[plr] = hl
end

local function createSkeleton(plr)
    if not skeletonOn or plr == player or not isAlive(plr) then return end
    if skeletonDrawings[plr] then return end
    local lines = {}
    for i = 1, 15 do
        local ok, line = pcall(function() return Drawing.new("Line") end)
        if ok and line then
            line.Color = Color3.fromRGB(255, 40, 40)
            line.Thickness = 1.8
            line.Visible = true
            table.insert(lines, line)
        end
    end
    if #lines > 0 then skeletonDrawings[plr] = lines end
end

local function updateESP()
    clearAll()
    for _, plr in pairs(game.Players:GetPlayers()) do
        createBox(plr)
        createTracer(plr)
        createChams(plr)
        createSkeleton(plr)
    end
end

-- Limpia cuando mueren o salen
local function setupPlayer(plr)
    plr.CharacterAdded:Connect(function()
        task.wait(0.4)
        if espBoxes then createBox(plr) end
        if tracersOn then createTracer(plr) end
        if chamsOn then createChams(plr) end
        if skeletonOn then createSkeleton(plr) end
    end)
    plr.CharacterRemoving:Connect(function()
        removeESP(plr)
    end)
end

for _, plr in pairs(game.Players:GetPlayers()) do
    setupPlayer(plr)
end
game.Players.PlayerAdded:Connect(setupPlayer)
game.Players.PlayerRemoving:Connect(function(plr)
    removeESP(plr)
end)

