crearToggle(personContent, "Noclip", 3, function(state)
    noclip = state
    if state then
        noclipConnection = RunService.Stepped:Connect(function()
            local char = player.Character
            if not char then return end
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end)
    else
        if noclipConnection then noclipConnection:Disconnect(); noclipConnection = nil end
        local char = player.Character
        if char then
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = true end
            end
        end
    end
end)

player.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then
        hum.WalkSpeed = speedValue
        if infJump then
            jumpConnection = UserInputService.JumpRequest:Connect(function()
                hum:ChangeState(Enum.HumanoidStateType.Jumping)
            end)
        end
    end
    if noclip and not noclipConnection then
        noclipConnection = RunService.Stepped:Connect(function()
            for _, part in pairs(char:GetDescendants()) do
                if part:IsA("BasePart") then part.CanCollide = false end
            end
        end)
    end
    actualizarHitbox()
end)

local function switchTab(tab)
    combatContent.Visible = tab == "combat"
    espContent.Visible = tab == "esp"
    personContent.Visible = tab == "person"
    tabCombat.BackgroundColor3 = tab == "combat" and AZUL or AZUL_BTN
    tabEsp.BackgroundColor3 = tab == "esp" and AZUL or AZUL_BTN
    tabPerson.BackgroundColor3 = tab == "person" and AZUL or AZUL_BTN
end

tabCombat.MouseButton1Click:Connect(function() switchTab("combat") end)
tabEsp.MouseButton1Click:Connect(function() switchTab("esp") end)
tabPerson.MouseButton1Click:Connect(function() switchTab("person") end)

openText.MouseButton1Click:Connect(function()
    menuAbierto = not menuAbierto
    frame.Visible = menuAbierto
end)

closeBtn.MouseButton1Click:Connect(function()
    menuAbierto = false
    frame.Visible = false
end)
