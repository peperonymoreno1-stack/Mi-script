                    local l = Instance.new("TextLabel")
                    l.Size = UDim2.new(1, 0, 0, 18)
                    l.Position = UDim2.new(0, 0, 0, yOff)
                    l.BackgroundTransparency = 1
                    l.Text = txt
                    l.TextColor3 = color
                    l.TextSize = 13
                    l.Font = Enum.Font.GothamBold
                    l.Parent = bb
                    yOff += 18
                end
                
                if espNameOn then addLabel(p.Name, AZUL) end
                if espVidaOn and hum then 
                    addLabel("HP: "..math.floor(hum.Health), Color3.fromRGB(255, 80, 80)) 
                end
                if espMetrosOn then addLabel(dist .. "m", Color3.fromRGB(255, 220, 50)) end
                
                -- Box
                if espBoxOn then
                    local box = Instance.new("SelectionBox")
                    box.Adornee = hrp
                    box.Color3 = AZUL
                    box.LineThickness = 0.05
                    box.SurfaceTransparency = 0.8
                    box.Parent = hrp
                    table.insert(espObjs, box)
                end
                
                -- Line (mejorado)
                if espLineOn then
                    local screenPos, onScreen = camera:WorldToViewportPoint(hrp.Position)
                    if onScreen then
                        local lineGui = Instance.new("ScreenGui")
                        lineGui.ResetOnSpawn = false
                        lineGui.Parent = playerGui
                        table.insert(espObjs, lineGui)
                        
                        local line = Instance.new("Frame")
                        line.BackgroundColor3 = AZUL
                        line.BorderSizePixel = 0
                        line.Size = UDim2.new(0, 2, 0, 2)
                        line.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y)
                        line.Parent = lineGui
                    end
                end
            end
        end
    end)
end

-- Conectar el toggle principal de ESP
crearToggle(espPage, "ESP", 1, function(state)
    espOn = state
    if state then
        iniciarESP()
    else
        limpiarESP()
        if espConn then espConn:Disconnect() end
    end
end)

print("✅ Gatito Hub completado correctamente!")
