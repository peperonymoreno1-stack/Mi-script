-- Función limpiar ESP
local function limpiarESP()
    for _, obj in pairs(espObjects) do
        pcall(function() obj:Destroy() end)
    end
    espObjects = {}
end

-- Función actualizar hitbox
local function actualizarHitbox()
    for _, p in pairs(game.Players:GetPlayers()) do
        if p ~= player and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                local existing = hrp:FindFirstChild("HitboxExpander")
                if existing then existing:Destroy() end
                if hitboxOn then
                    local box = Instance.new("Part")
                    box.Name = "HitboxExpander"
                    box.Size = Vector3.new(hitboxSize, hitboxSize, hitboxSize)
                    box.CFrame = hrp.CFrame
                    box.Anchored = false
                    box.CanCollide = false
                    box.Transparency = espBoxOn and 0.5 or 1
                    box.BrickColor = BrickColor.new("Bright blue")
                    box.Material = Enum.Material.Neon
                    local weld = Instance.new("WeldConstraint")
                    weld.Part0 = hrp
                    weld.Part1 = box
                    weld.Parent = box
                    box.Parent = hrp
                end
            end
        end
    end
end

-- ESP LOOP
local function iniciarESP()
    limpiarESP()
    if espConnection then espConnection:Disconnect() end
    espConnection = RunService.Heartbeat:Connect(function()
        limpiarESP()
        for _, p in pairs(game.Players:GetPlayers()) do
            if p ~= player and p.Character then
                local char = p.Character
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hrp then
                    local _, onScreen = camera:WorldToViewportPoint(hrp.Position)
                    local dist = math.floor((hrp.Position - camera.CFrame.Position).Magnitude)

                    -- Billboard ESP
                    local billboard = Instance.new("BillboardGui")
                    billboard.Size = UDim2.new(0, 120, 0, 80)
                    billboard.StudsOffset = Vector3.new(0, 3, 0)
                    billboard.AlwaysOnTop = true
                    billboard.Parent = hrp
                    table.insert(espObjects, billboard)

                    local yOffset = 0

                    if espNameOn then
                        local lbl = Instance.new("TextLabel")
                        lbl.Size = UDim2.new(1, 0, 0, 15)
                        lbl.Position = UDim2.new(0, 0, 0, yOffset)
                        lbl.BackgroundTransparency = 1
                        lbl.Text = p.Name
                        lbl.TextColor3 = AZUL
                        lbl.TextSize = 12
                        lbl.Font = Enum.Font.GothamBold
                        lbl.Parent = billboard
                        yOffset = yOffset + 15
                    end

                    if espVidaOn and hum then
                        local lbl = Instance.new("TextLabel")
                        lbl.Size = UDim2.new(1, 0, 0, 15)
                        lbl.Position = UDim2.new(0, 0, 0, yOffset)
                        lbl.BackgroundTransparency = 1
                        lbl.Text = "HP: " .. math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth)
                        lbl.TextColor3 = Color3.fromRGB(255, 50, 50)
                        lbl.TextSize = 11
                        lbl.Font = Enum.Font.Gotham
                        lbl.Parent = billboard
                        yOffset = yOffset + 15
                    end

                    if espMetrosOn then
                        local lbl = Instance.new("TextLabel")
                        lbl.Size = UDim2.new(1, 0, 0, 15)
                        lbl.Position = UDim2.new(0, 0, 0, yOffset)
                        lbl.BackgroundTransparency = 1
                        lbl.Text = dist .. "m"
                        lbl.TextColor3 = Color3.fromRGB(255, 255, 50)
                        lbl.TextSize = 11
                        lbl.Font = Enum.Font.Gotham
                        lbl.Parent = billboard
                    end

                    -- ESP Box
                    if espBoxOn then
                        local box = Instance.new("SelectionBox")
                        box.Color3 = AZUL
                        box.LineThickness = 0.05
                        box.SurfaceTransparency = 0.7
                        box.SurfaceColor3 = AZUL
                        box.Adornee = hrp
                        box.Parent = hrp
                        table.insert(espObjects, box)
                    end

                    -- ESP Line
                    if espLineOn then
                        local line = Instance.new("BillboardGui")
                        line.Size = UDim2.new(0, 2, 0, 2)
                        line.AlwaysOnTop = true
                        line.Parent = hrp
                        table.insert(espObjects, line)
                    end
                end
            end
        end
    end)
end

