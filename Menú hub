    lbl.TextSize = 13
    lbl.Font = Enum.Font.Gotham
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = optBg

    local togBg = Instance.new("TextButton")
    togBg.Size = UDim2.new(0, 44, 0, 24)
    togBg.Position = UDim2.new(1, -54, 0.5, -12)
    togBg.BackgroundColor3 = Color3.fromRGB(30, 30, 60)
    togBg.BorderSizePixel = 0
    togBg.Text = ""
    togBg.Parent = optBg
    Instance.new("UICorner", togBg).CornerRadius = UDim.new(0, 12)

    local togCircle = Instance.new("Frame")
    togCircle.Size = UDim2.new(0, 18, 0, 18)
    togCircle.Position = UDim2.new(0, 3, 0.5, -9)
    togCircle.BackgroundColor3 = Color3.fromRGB(150, 150, 150)
    togCircle.BorderSizePixel = 0
    togCircle.Parent = togBg
    Instance.new("UICorner", togCircle).CornerRadius = UDim.new(0, 9)

    local state = false
    togBg.MouseButton1Click:Connect(function()
        state = not state
        togBg.BackgroundColor3 = state and AZUL or Color3.fromRGB(30, 30, 60)
        togCircle.Position = state and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
