-- ESP PAGE
local function limpiarESP()
    for _, o in pairs(espObjs) do pcall(function() o:Destroy() end) end
    espObjs = {}
end

local function iniciarESP()
    if espConn then espConn:Disconnect() end
    espConn = RunService.Heartbeat:Connect(function()
        limpiarESP()
        for _, p in pairs(game.Players:GetPlayers()) do
            if p ~= player and p.Character then
                local hrp = p.Character:FindFirstChild("HumanoidRootPart")
                local hum = p.Character:FindFirstChildOfClass("Humanoid")
                if hrp then
                    local dist = math.floor((hrp.Position - camera.CFrame.Position).Magnitude)
                    local bb = Instance.new("BillboardGui")
                    bb.Size = UDim2.new(0, 130, 0, 90)
                    bb.StudsOffset = Vector3.new(0, 3.5, 0)
                    bb.AlwaysOnTop = true
                    bb.Parent = hrp
                    table.insert(espObjs, bb)

                    local yOff = 0
                    local function addLabel(txt, color)
                        local l = Instance.new("TextLabel")
                        l.Size = UDim2.new(1, 0, 0, 16)
                        l.Position = UDim2.new(0, 0, 0, yOff)
                        l.BackgroundTransparency = 1
                        l.Text = txt
                        l.TextColor3 = color
                        l.TextSize = 12
                        l.Font = Enum.Font.GothamBold
                        l.Parent = bb
                        yOff = yOff + 16
                    end

                    if espNameOn then addLabel(p.Name, AZUL) end
                    if espVidaOn and hum then addLabel("HP: "..math.floor(hum.Health).."/"..math.floor(hum.MaxHealth), Color3.fromRGB(255,80,80)) end
                    if espMetrosOn then addLabel(dist.."m", Color3.fromRGB(255,220,50)) end

                    if espBoxOn then
                        local sel = Instance.new("SelectionBox")
                        sel.Color3 = AZUL
                        sel.LineThickness = 0.05
                        sel.SurfaceTransparency = 0.8
                        sel.SurfaceColor3 = AZUL
                        sel.Adornee = hrp
                        sel.Parent = hrp
                        table.insert(espObjs, sel)
                    end

                    if espLineOn then
                        local sg2 = Instance.new("ScreenGui")
                        sg2.Name = "ESPLine"
                        sg2.ResetOnSpawn = false
                        sg2.AlwaysOnTop = true
                        sg2.Parent = playerGui
                        table.insert(espObjs, sg2)
                        local frame2 = Instance.new("Frame")
                        frame2.BackgroundColor3 = AZUL
                        frame2.BorderSizePixel = 0
                        frame2.Size = UDim2.new(0, 2, 0, 2)
                        local screenPos, vis = camera:WorldToViewportPoint(hrp.Position)
                        if vis then
                            frame2.Position = UDim2.new(0, screenPos.X, 0, screenPos.Y)
                        end
                        frame2.Parent = sg2
                    end
                end
            end
        end
    end)
end

