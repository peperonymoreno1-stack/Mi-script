local Aimbot, Silent, FOVVis, FOV = false, false, false, 120
local ESP, Name, Health, Box, Dist, Line = false, false, false, false, false, false
local SpeedE, SpeedV, Noclip, JumpE, JumpP = false, 50, false, false, 100

local FOVCircle = Drawing.new("Circle"); FOVCircle.Thickness=2; FOVCircle.Color=Color3.fromRGB(0,100,255); FOVCircle.Filled=false; FOVCircle.Visible=false

local function GetClosest()
    local closest, dist = nil, FOV
    for _,p in Players:GetPlayers() do
        if p\~=player and p.Character and p.Character:FindFirstChild("Head") and p.Character.Humanoid.Health>0 then
            local pos, on = Camera:WorldToViewportPoint(p.Character.Head.Position)
            if on then
                local d = (Vector2.new(pos.X,pos.Y) - Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)).Magnitude
                if d < dist then dist=d; closest=p end
            end
        end
    end
    return closest
end

RunService.RenderStepped:Connect(function()
    FOVCircle.Visible = FOVVis; FOVCircle.Position = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2); FOVCircle.Radius = FOV
    if Aimbot then
        local t = GetClosest()
        if t and t.Character and t.Character.Head then Camera.CFrame = CFrame.lookAt(Camera.CFrame.Position, t.Character.Head.Position) end
    end
end)

-- Silent Aim (mejorado para Arsenal)
local mt = getrawmetatable(game); local old = mt.__namecall; setreadonly(mt,false)
mt.__namecall = newcclosure(function(self, ...)
    local args = {...}
    if Silent and (self.Name:find("Shoot") or self.Name:find("Bullet") or self.Name:find("Fire")) then
        local t = GetClosest()
        if t and t.Character and t.Character.Head then args[2] = t.Character.Head.Position end
    end
    return old(self, unpack(args))
end)
setreadonly(mt, true)

-- ESP
local espCache = {}
RunService.RenderStepped:Connect(function()
    for _,p in Players:GetPlayers() do
        if p\~=player and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            if not espCache[p] then
                espCache[p] = {box=Drawing.new("Square"), name=Drawing.new("Text"), health=Drawing.new("Square"), dist=Drawing.new("Text"), line=Drawing.new("Line")}
                local e = espCache[p]
                e.box.Thickness=2; e.box.Color=Color3.fromRGB(0,100,255); e.box.Filled=false
                e.name.Size=14; e.name.Color=Color3.fromRGB(0,100,255); e.name.Outline=true; e.name.Center=true
                e.health.Color=Color3.fromRGB(0,255,0); e.health.Filled=true
                e.dist.Size=13; e.dist.Color=Color3.fromRGB(0,100,255); e.dist.Outline=true; e.dist.Center=true
                e.line.Thickness=1; e.line.Color=Color3.fromRGB(0,100,255)
            end
            local e = espCache[p]
            local root = p.Character.HumanoidRootPart
            local head = p.Character.Head
            local hum = p.Character.Humanoid
            local pos, on = Camera:WorldToViewportPoint(root.Position)
            if on and ESP then
                local t = Camera:WorldToViewportPoint(head.Position + Vector3.new(0,2,0))
                local b = Camera:WorldToViewportPoint(root.Position - Vector3.new(0,3,0))
                local h = b.Y - t.Y

                if Box then e.box.Size=Vector2.new(h/2,h); e.box.Position=Vector2.new(t.X - e.box.Size.X/2, t.Y); e.box.Visible=true else e.box.Visible=false end
                if Name then e.name.Text=p.Name; e.name.Position=Vector2.new(t.X, t.Y-20); e.name.Visible=true else e.name.Visible=false end
                if Health then local hp = hum.Health/hum.MaxHealth; e.health.Size=Vector2.new(3,h*hp); e.health.Position=Vector2.new(t.X-e.box.Size.X/2-6, t.Y + h*(1-hp)); e.health.Visible=true else e.health.Visible=false end
                if Dist then local d = math.floor((root.Position - (player.Character and player.Character.HumanoidRootPart.Position or Vector3.new())).Magnitude); e.dist.Text=d.."m"; e.dist.Position=Vector2.new(b.X, b.Y+5); e.dist.Visible=true else e.dist.Visible=false end
                if Line then e.line.From=Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y); e.line.To=Vector2.new(pos.X,pos.Y); e.line.Visible=true else e.line.Visible=false end
            else
                for _,v in pairs(e) do v.Visible=false end
            end
        end
    end
end)

